# access tor services over local tor socks proxy
Host *.onion
    # Has no effect if already defined in ´Host *´ section
    ConnectTimeout 60
    ProxyCommand=nc -X 5 -x localhost:9150 %h %p

# Assume all pq hosts are root-only with shared ssh key
