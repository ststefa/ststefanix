# If multiple Host stanzas match then they will be merged
# If an option matches multiple times then the first (topmost) entry wins

Host *
    ForwardAgent yes
    ForwardX11 yes
    StrictHostKeyChecking no
    #ConnectTimeout 30

    # https://apple.stackexchange.com/questions/48502/how-can-i-permanently-add-my-ssh-private-key-to-keychain-so-it-is-automatically
    # https://docs.github.com/en/enterprise-server@2.22/github/authenticating-to-github/generating-a-new-ssh-key-and-adding-it-to-the-ssh-agent
    # Manage keys using keychain
    # - add: ssh-add --apple-use-keychain <keyfile>
    # - del: ssh-add -d --apple-use-keychain <keyfile> (get <keyfile> name from Keychain Access.app if unavailable)
    # delete all: ssh-add -D
    # load all from keychain: ssh-add --apple-load-keychain
    AddKeysToAgent ask

    # Apple extension, not available with GNU ssh
    #UseKeychain yes

    # Do not specify this or it will be used for any connection
    # The default is better: Attempt all keys from agent unless IdentityFile is explicitly configured
    #IdentityFile ~/.ssh/id_rsa

    # https://code.visualstudio.com/docs/remote/troubleshooting#_enabling-alternate-ssh-authentication-methods
    # This behaviour is faster but confusing
    #ControlMaster auto
    #ControlPath  ~/.ssh/socket.%r@%h-%p
    #ControlPersist  600
    # Prefer modern encryption methods
    MACs +hmac-sha2-512
    KexAlgorithms +curve25519-sha256@libssh.org
    # Enable StrongBox integration
    #IdentityAgent "~/Library/Group Containers/group.strongbox.mac.mcguill/agent.sock"

