#!/bin/bash

# Manage kubectl context switching

cd "${HOME}/.kube" || exit 1

case $1 in
    "")
        LINKS_TO="$(basename "$(readlink -f config)")"
        echo ${LINKS_TO%.*}
        ;;
    "-l")
        for FILE in *kubeconfig ; do
            echo ${FILE%.*}
        done
        ;;
    "-h")
        cat <<EOF
Manage kubectl context
usage: $0 [-l | -h | <ctx>]
where:
  -l:    List available contexts
  -h:    This help
  <ctx>: Switch to this context
EOF
        ;;
    *)
        [[ -f $1.kubeconfig ]] || ( echo "No context with name $1. Try -l" ; exit 1 )
        ln -fs $1.kubeconfig config
        ;;
esac
