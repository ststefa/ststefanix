[distutils]
index-servers =
    pypi
    testpypi
    gitlab-home
    dbartifactory

[pypi]
repository = https://upload.pypi.org/legacy/
username = ststefa

[testpypi]
repository = https://test.pypi.org/legacy/
username = ststefa
# password or token (optionally) comes from Keychain.app. See https://packaging.python.org/en/latest/specifications/pypirc/#using-another-package-index
# pip install keyring ; keyring set https://test.pypi.org/legacy/ ststefa
# or use token
#  username = __token__
#  password = {1p}pypi.org

[gitlab-home]
repository = https://gitlab.tinkerbase.org/api/v4/projects/pub%2Fmypi/packages/pypi
username = default
# password from Keychain.app

[dbartifactory]
repository = https://bahnhub.tech.rz.db.de/artifactory/api/pypi/dsd-devops-pypi-prod-local
username = stefansteinert
# password from Keychain.app
